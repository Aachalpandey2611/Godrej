{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    }
  ],
  "routes": [
    { "src": "/.well-known/(.*)", "dest": "/.well-known/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
